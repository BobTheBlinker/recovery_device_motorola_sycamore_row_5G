# Android 16 Beanpod/Microtrust security services required by metadata FBE.
# V18 runs teei_daemon with its exact stock system/system + SYS_RAWIO + tee
# identity. Beanpod and Gatekeeper retain the proven V17 recovery identity.
service teei_daemon /vendor/bin/teei_daemon \
    -r 020b0000000000000000000000000000 \
    -r 020f0000000000000000000000000000 \
    -r 06090000000000000000000000000000 \
    -r 05120000000000000000000000000000 \
    -r 40188311faf343488db888ad39496f9a \
    -r 07060000000000000000000000007169 \
    -r 4be4f7dc1f2c11e5b5f7727283247c7f \
    -r 9073f03a9618383bb1856eb3f990babd \
    -r 08050000000000000000000000003419 \
    -r 5020170115e016302017012521300000 \
    -r 0f5eed3c3b5a47afacca69a84bf0efad \
    -r 07407000000000000000000000000000 \
    -r 05160000000000000000000000000000 \
    -r 91dba524a6e24909acc48abd7163121a \
    -r 08070000000000000000000000008270 \
    -r 09080000000000000000000000009381 \
    -t 08030000000000000000000000000000 \
    -t 85f630e0f0964c5fa2cc268ce04e3da3 \
    -t 98fb95bcb4bf42d26473eae48690d7ea \
    -t 7b66512021214487ba710a51d7ea78fe \
    -t 09010000000000000000000000000000
    class core
    user system
    group system
    disabled
    capabilities SYS_RAWIO
    seclabel u:r:tee:s0

service vendor.keymint-beanpod /vendor/bin/hw/android.hardware.security.keymint@2.0-service.beanpod
    class early_hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw
    setenv LD_PRELOAD /vendor/lib64/libsycamore_keytrace.so

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw

on init
    chmod 0660 /dev/isee_tee0
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/teei_client
    chmod 0660 /dev/teei_config
    chmod 0660 /dev/teei_fp
    chmod 0660 /dev/teeperf
    chmod 0660 /dev/ut_keymaster
    # V11-persist-ro: expose the stock Microtrust VFS namespace without
    # permitting journal replay or persistent writes.
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/sdc14 /mnt/vendor/persist ro noatime nosuid nodev wait noload
    start teei_daemon

on property:init.svc.teei_daemon=running
    start vendor.keymint-beanpod
    start vendor.gatekeeper-1-0

# V16 boot-decrypt-unlock: match the stock post-fs-data logini lifecycle only
# after Soter, persist VFS, and physical RPMB are all healthy.  Each producer
# reaches its terminal value once, so this compound action is not retriggered.
on property:vendor.soter.teei.init=INIT_OK && property:vendor.soter.teei.persist=OPEN && property:vendor.soter.teei.rpmb.flag=ok
    setprop vendor.soter.teei.logini start
