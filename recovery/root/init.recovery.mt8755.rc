import /init.recovery.crypto.rc

on init
    # Stock recovery intentionally omits CPUFreq from modules.load.recovery.
    # TWRP is long-lived, so enable MT8755 hardware DVFS after first-stage
    # recovery module loading has completed.
    # Stock vendor_dlkm generic-ADC thermal provider for NTC sensors.
    # Required for usb_ntc and the MTK USB burn protection worker.
    insmod /thermal-modules/thermal-generic-adc.ko
    insmod /thermal-modules/board_temp.ko

    # Recovery-only SCP thermal ABI provider. Do not load the real SCP here.
    # Load the proven MT8755 LVTS dependency chain in this exact order.
    insmod /thermal-modules/scp_recovery_shim.ko
    insmod /thermal-modules/mtk_gpu_hal.ko
    insmod /thermal-modules/mtk_bp_thl.ko
    insmod /thermal-modules/gpueb.ko
    insmod /thermal-modules/mtk_gpufreq_wrapper.ko
    insmod /thermal-modules/thermal_interface.ko
    insmod /thermal-modules/soc_temp_lvts.ko

    insmod /lib/modules/mediatek-cpufreq-hw.ko

    symlink /dev/block /dev/block/bootdevice
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 11201000.usb0

# Stock recovery uses these aliases for MTK's UFS boot-region handling.
on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

# Sycamore recovery MTP FunctionFS plumbing.
#
# TeamWin's generic recovery init creates the configfs gadget, ADB FunctionFS,
# and fastboot FunctionFS. Sycamore adds only the missing MTP FunctionFS
# instance used by TWRP's libtwrpmtp-ffs implementation.
on post-fs
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024,rmode=0770,fmode=0660
    setprop sys.usb.mtp.device_type 3

# TWRP requests mtp,adb when its MTP server is enabled.
# adbd and TWRP's MTP FunctionFS implementation signal readiness independently.
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

# Bind the composite gadget only after both FunctionFS implementations have
# published their descriptors.
on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# TeamWin's generic configfs cleanup removes f1. MTP+ADB also owns f2.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2
    setprop sys.usb.ffs.mtp.ready 0

# Configure the regulator-vibrator LED for TWRP's native transient haptics.
# Selecting the transient trigger creates duration/activate/state; state=1
# makes each activation turn the vibrator on for the requested duration.
on boot
    write /sys/class/leds/vibrator/trigger transient
    write /sys/class/leds/vibrator/state 1
