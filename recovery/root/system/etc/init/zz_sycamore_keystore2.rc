service sycamore_keystore2_stage /system/bin/sh /system/bin/sycamore_keystore2_stage.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service keystore2 /system/bin/keystore2 /tmp/misc/keystore-sycamore
    override
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    disabled
    seclabel u:r:keystore:s0

on property:ro.crypto.type=file
    start sycamore_keystore2_stage

on property:twrp.user.keystore_stage=ready
    start keystore2

on property:twrp.user.keystore_stage=failed
    start keystore2
