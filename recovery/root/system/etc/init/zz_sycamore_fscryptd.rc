# Persistent, crypto-only vold/fscrypt owner for enforcing recovery.
# Explicit seclabel is required because recovery-cpio executables boot as rootfs.
service sycamore_fscryptd /system/bin/sycamore_fscryptd
    class core
    user root
    group root
    seclabel u:r:vold:s0

on init
    restorecon /system/bin/vold_prepare_subdirs
    start sycamore_fscryptd
