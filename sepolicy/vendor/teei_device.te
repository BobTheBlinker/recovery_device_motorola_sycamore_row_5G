# Exact Microtrust device-node types used by the production Sycamore policy.
type teei_client_device, dev_type;
type teei_config_device, dev_type;
type teei_vfs_device, dev_type;
type teei_fp_device, dev_type;
type ut_keymaster_device, dev_type;
type teei_rpmb_device, dev_type;
type utr_tui_device, dev_type;

# Permit only the production tee domain to use these device interfaces.  The
# daemon receives SYS_RAWIO from init and no other Linux capability.
allow tee self:global_capability_class_set sys_rawio;
allow tee teei_client_device:chr_file rw_file_perms;
allow tee teei_config_device:chr_file rw_file_perms;
allow tee teei_vfs_device:chr_file rw_file_perms;
allow tee teei_fp_device:chr_file rw_file_perms;
allow tee ut_keymaster_device:chr_file rw_file_perms;
allow tee teei_rpmb_device:chr_file rw_file_perms;
allow tee utr_tui_device:chr_file rw_file_perms;
