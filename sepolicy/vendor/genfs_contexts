# Sycamore power-supply sysfs consumed by the recovery Health HAL.
#
# AOSP Health policy grants hal_health_server access to sysfs_batteryinfo.
# Keep these labels device-specific rather than granting generic sysfs access.

genfscon sysfs /devices/platform/soc/11b20000.i2c/i2c-3/3-0055/power_supply/battery u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc/11b20000.i2c/i2c-3/3-001a/power_supply/charger u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/charger/power_supply/mtk-master-charger u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/charger/power_supply/mtk-slave-charger u:object_r:sysfs_batteryinfo:s0
