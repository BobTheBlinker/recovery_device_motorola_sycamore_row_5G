# Keystore2 is staged into the recovery rootfs but runs in its native
# AOSP keystore domain.
recovery_only(`
  allow keystore rootfs:file {
      entrypoint
      execute
      getattr
      map
      open
      read
  };

  allow keystore rootfs:dir {
      open
      read
  };
')

# Recovery-side Keystore2 SQLite database and sidecars.
allow keystore tmpfs:dir {
    add_name
    getattr
    open
    read
    remove_name
    search
    write
};

allow keystore tmpfs:file {
    create
    getattr
    ioctl
    lock
    map
    open
    read
    setattr
    unlink
    write
};

allowxperm keystore tmpfs:file ioctl 0xf50c;

# Recovery-side Keystore2 staging publishes completion state to init.
recovery_only(`
  set_prop(recovery, twrp_user_decrypt_prop)
')
